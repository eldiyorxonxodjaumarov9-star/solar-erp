# SQL baza (Firebase o'rniga)
# PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost:5432/solar_erp
# Bo'sh qoldirilsa — SQLite fayl: data/solar-erp.db
DATABASE_URL=
# SQLITE_PATH=data/solar-erp.db
# Taminot katalog (CSV/TXT/SQLite papka)
# SUPPLY_DATA_DIR=./data/supply
# SUPPLY_EXCHANGE_RATE=12500
# Admin narx/API: ADMIN_LOGIN=admin  ADMIN_PASSWORD=admin123
# SUPPLY_ADMIN_TOKEN=optional-secret
# VPS: SUPPLY_DB_PATH=/root/solar-erp/data/supply/supply.db
# PostgreSQL SSL (masalan cloud): PG_SSL=true

# APK (telefon): VPS/public API — localhost ishlatilmaydi
VITE_ANDROID_API_BASE=http://77.237.237.94
# Umumiy production API (web / fallback)
VITE_API_BASE=http://77.237.237.94
# Desktop lokal (npm run desktop o‘zi qo‘yadi)
# VITE_API_BASE_HTTP=http://127.0.0.1:5000


# Desktop + APK bir xil yig'ish: npm run sync:clients
# VPS + APK + Desktop: npm run sync:clients:deploy
# npm run desktop   — build + server + oyna
# npm run desktop:exe — Windows uchun portable / o‘rnatgich (desktop-dist/)

# API server (server.js) — Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
# Vaqt jadvali — `.env` da o‘zgartiring (PM2: `npx pm2 restart solar-erp --update-env`).
# Format: `HH:MM` (masalan 13:30), yoki faqat soat `14` (= 14:00), yoki to‘liq cron: `30 14 * * *`
TELEGRAM_MORNING_SCHEDULE=0 7 * * *
# Masterlar «Keldi/Ketdi» eslatmalari (13:00 / 18:00). Default O‘CHIQ.
# Eski xabar («Xurmatli masterlar…») yuborilmasin. Yoqish: true
TELEGRAM_MASTER_REMINDERS_AUTO=false
# Eski flag (ixtiyoriy): TELEGRAM_MASTER_REMINDERS=false
TELEGRAM_MASTER_MIDDAY_SCHEDULE=0 13 * * *
TELEGRAM_MASTER_EVENING_SCHEDULE=0 18 * * *
# Kunlik attendance yakuni (Toshkent 13:00) — Telegram guruhiga
TELEGRAM_DAILY_ATTENDANCE_SCHEDULE=0 13 * * *
# O‘chirish: TELEGRAM_DAILY_ATTENDANCE_AUTO=false
TELEGRAM_DAILY_ATTENDANCE_AUTO=true
# POST /api/telegram/daily-attendance-report (ixtiyoriy; bo‘sh bo‘lsa MONTHLY secret ishlatiladi)
TELEGRAM_DAILY_ATTENDANCE_SECRET=
# Oylik hisobot tekshiruvi (har kuni ishlaydi; faqat oyning oxirgi kuni yuboriladi)
TELEGRAM_MONTHLY_SCHEDULE=5 21 * * *
#
# Eski ERP rasm avto-yuborishi (har 30 s). Kunlik faqat Toshkent 07:00 uchun odatda KERAK EMAS.
# TELEGRAM_ERP_POLL=true
#
# Guruhdan getUpdates (inbound). Default O‘CHIQ — bir nechta bot instance conflict bermasligi uchun.
# Faqat bitta process: TELEGRAM_INBOUND_POLL=true
TELEGRAM_INBOUND_POLL=false
ERP_API_URL=
PORT=5000

# Oylik hisobot (oyning oxirgi kuni, TELEGRAM_MONTHLY_SCHEDULE bo‘yicha) — 3 ta fayl guruhingizga.
# O‘chirish: TELEGRAM_MONTHLY_AUTO=false
# Faqat Firebase: avtomatik uchun JSON URL (ixtiyoriy): MONTHLY_REPORT_DATA_URL
TELEGRAM_MONTHLY_AUTO=true
MONTHLY_REPORT_DATA_URL=
MONTHLY_REPORT_FETCH_SECRET=
# POST /api/telegram/monthly-report va brauzer: bir xil maxfiy kalit
TELEGRAM_MONTHLY_REPORT_SECRET=
# Frontend (.env): serverdagi TELEGRAM_MONTHLY_REPORT_SECRET bilan bir xil
VITE_MONTHLY_REPORT_SECRET=

# Eski Firebase sozlamalari endi kerak emas (migratsiya uchun migrate:sql ishlatiladi)
