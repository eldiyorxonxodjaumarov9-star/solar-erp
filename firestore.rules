rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'custom'
        && sessionActive() && profileActive()
        && request.auth.token.role in ['admin', 'usta', 'asisten']
        && request.auth.token.accountId is string
        && request.auth.uid == request.auth.token.role + ':' + request.auth.token.accountId;
    }
    function activeProfile(data) { return data.get('disabled',false) == false && !(data.get('status','active') in ['inactive','noaktiv','off','disabled']); }
    function profileActive() {
      return request.auth.token.role == 'admin'
        || (request.auth.token.role == 'usta' && (exists(/databases/$(database)/documents/workers/$(request.auth.token.accountId))
          ? activeProfile(get(/databases/$(database)/documents/workers/$(request.auth.token.accountId)).data)
          : activeProfile(get(/databases/$(database)/documents/users/$(request.auth.token.accountId)).data)))
        || (request.auth.token.role == 'asisten' && activeProfile(get(/databases/$(database)/documents/assistants/$(request.auth.token.accountId)).data));
    }
    function sessionActive() {
      return !exists(/databases/$(database)/documents/accountSecurity/$(request.auth.uid))
        || (get(/databases/$(database)/documents/accountSecurity/$(request.auth.uid)).data.get('disabled',false) == false
          && request.auth.token.get('sessionVersion',0) == get(/databases/$(database)/documents/accountSecurity/$(request.auth.uid)).data.get('sessionVersion',0));
    }
    function isAdmin() { return isAuthenticated() && request.auth.token.role == 'admin'; }
    function workerId() { return request.auth.token.workerId; }
    function assistantId() { return request.auth.token.assistantId; }
    function isWorker() { return isAuthenticated() && request.auth.token.role == 'usta' && workerId() == request.auth.token.accountId; }
    function isAssistant() { return isAuthenticated() && request.auth.token.role == 'asisten' && assistantId() == request.auth.token.accountId; }
    function personId() { return isWorker() ? workerId() : 'asst_' + assistantId(); }
    function ownPerson(id) { return (isWorker() || isAssistant()) && id == personId(); }
    function safeProfile(data) {
      return !data.keys().hasAny(['password', 'pin', 'credential', 'credentials', 'adminPassword', 'passwordHash', 'passwordSalt', 'privateKey', 'secret', 'token']);
    }
    function noPayroll(data) {
      return !data.keys().hasAny(['payrollWorkerId', 'payrollMonth', 'payrollPaymentType', 'salary', 'salaryHistory', 'dailySalary']);
    }
    function assigned(data) {
      return isWorker() && (data.get('ustaId', '') == workerId()
        || data.get('assignedWorkerId', '') == workerId()
        || workerId() in data.get('assignedWorkerIds', []));
    }
    function assignedProject(id) {
      return assigned(get(/databases/$(database)/documents/projects/$(id)).data);
    }
    function businessReader() { return isAdmin() || isAssistant(); }
    function ownExpense(data) { return isWorker() && (data.get('payrollWorkerId', '') == workerId() || (noPayroll(data) && data.get('ustaId', '') == workerId())); }
    function workerExpense(data) {
      return isWorker() && data.ustaId == workerId() && noPayroll(data)
        && data.keys().hasOnly(['ustaId', 'ustaName', 'brigadeId', 'brigadeName', 'projectId', 'projectName', 'type', 'amount', 'date', 'comment', 'receiptImageData', 'createdAt', 'updatedAt'])
        && data.type in ['Materiallar', 'Transport', 'Ijara', 'Boshqa']
        && data.amount is string && data.amount.matches('^[0-9]+$') && int(data.amount) > 0
        && assignedProject(data.projectId);
    }
    match /workers/{id} {
      allow read: if safeProfile(resource.data) && (isAdmin() || (isWorker() && id == workerId()));
      allow create: if isAdmin() && safeProfile(request.resource.data);
      allow update: if isAdmin() && safeProfile(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['disabled','status','login','loginLower','role']);
      allow delete: if isAdmin();
    }
    match /assistants/{id} {
      allow read: if safeProfile(resource.data) && (isAdmin() || (isAssistant() && id == assistantId()));
      allow create: if isAdmin() && safeProfile(request.resource.data);
      allow update: if isAdmin() && safeProfile(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['disabled','status','login','loginLower','role']);
      allow delete: if isAdmin();
    }
    // Legacy accounts and the future credential store are server-only (Admin SDK).
    match /users/{id} { allow read, write: if false; }
    match /accountSecurity/{id} { allow read, write: if false; }
    match /accountCredentials/{id} { allow read, write: if false; }
    match /expenses/{id} {
      allow read: if isAdmin() || ownExpense(resource.data);
      allow create: if isAdmin() || workerExpense(request.resource.data);
      allow update: if isAdmin() || (workerExpense(resource.data) && workerExpense(request.resource.data));
      allow delete: if isAdmin() || workerExpense(resource.data);
    }
    match /projects/{id} {
      allow read: if businessReader() || assigned(resource.data);
      allow create, delete: if businessReader();
      allow update: if businessReader() || (assigned(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'holat', 'updatedAt', 'stages', 'stageTelegramStatus', 'progress']));
    }
    match /brigades/{id} { allow read: if isAdmin() || isWorker() || isAssistant(); allow write: if isAdmin(); }
    match /commercialOffers/{id} { allow read, write: if businessReader(); }
    match /heatPumpForms/{id} { allow read, write: if businessReader(); }
    match /supplyCalculations/{id} { allow read, write: if businessReader(); }
    match /project_worker_days/{id} { allow read, write: if isAdmin(); }
    match /points/{id} { allow read: if isAdmin() || (isWorker() && resource.data.userId == workerId()); allow write: if isAdmin(); }
    match /user_activity_logs/{id} {
      allow read: if isAdmin() || ownPerson(resource.data.ustaId);
      allow create: if isAdmin() || (ownPerson(request.resource.data.ustaId) && noPayroll(request.resource.data) && safeProfile(request.resource.data));
      allow update: if isAdmin() || (ownPerson(resource.data.ustaId) && request.resource.data.ustaId == resource.data.ustaId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logoutTime', 'totalWorkTime', 'isOnline', 'logoutLocation', 'updatedAt']));
      allow delete: if isAdmin();
    }
    match /attendance/{id} {
      allow read: if isAdmin() || ownPerson(resource.data.userId);
      allow create, update: if isAdmin() || (ownPerson(request.resource.data.userId) && noPayroll(request.resource.data)
        && safeProfile(request.resource.data) && (!exists(/databases/$(database)/documents/attendance/$(id)) || resource.data.userId == request.resource.data.userId));
      allow delete: if isAdmin();
    }
    match /stage_photos/{id} {
      allow read: if isAdmin() || ownPerson(resource.data.ustaId);
      allow create: if isAdmin() || (ownPerson(request.resource.data.ustaId) && noPayroll(request.resource.data) && safeProfile(request.resource.data));
      allow update: if isAdmin() || (ownPerson(resource.data.ustaId) && request.resource.data.ustaId == resource.data.ustaId
        && noPayroll(request.resource.data) && safeProfile(request.resource.data));
      allow delete: if isAdmin() || ownPerson(resource.data.ustaId);
    }
    match /work_logs/{id} {
      allow read: if isAdmin() || (isWorker() && resource.data.workerId == workerId());
      allow create: if isAdmin() || (isWorker() && request.resource.data.workerId == workerId() && noPayroll(request.resource.data) && safeProfile(request.resource.data));
      allow update: if isAdmin() || (isWorker() && resource.data.workerId == workerId()
        && request.resource.data.workerId == workerId() && noPayroll(request.resource.data) && safeProfile(request.resource.data));
      allow delete: if isAdmin();
    }
    match /projectSteps/{id} {
      allow read: if businessReader() || (isWorker() && resource.data.uploadedBy == workerId());
      allow create: if isAdmin() || (isWorker() && request.resource.data.uploadedBy == workerId()
        && noPayroll(request.resource.data) && safeProfile(request.resource.data)
        && request.resource.data.status == 'pending' && assignedProject(request.resource.data.projectId));
      allow update: if isAdmin() || (isWorker() && resource.data.uploadedBy == workerId()
        && request.resource.data.uploadedBy == workerId() && resource.data.status == 'pending'
        && noPayroll(request.resource.data) && safeProfile(request.resource.data)
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.status == 'pending' && assignedProject(resource.data.projectId));
      allow delete: if isAdmin();
    }
    match /project_stage_locks/{id} { allow read: if businessReader() || assignedProject(id); allow write: if isAdmin(); }
    match /jalbalar/{id} {
      allow read: if isAdmin() || (isWorker() && resource.data.ustaId == workerId());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isWorker() && resource.data.ustaId == workerId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'doneAt', 'updatedAt']));
    }
    match /complaints/{id} { allow read: if isAdmin() || (isWorker() && resource.data.userId == workerId()); allow write: if isAdmin(); }
    match /usta_yorijnoma/{id} {
      allow read: if isAdmin() || (isWorker() && id == workerId());
      allow create, update: if isAdmin() || (isWorker() && id == workerId() && request.resource.data.workerId == workerId()
        && request.resource.data.keys().hasOnly(['workerId','login','name','signatureDataUrl','completedAt','documentTitle','createdAt','updatedAt']));
      allow delete: if isAdmin();
    }
    match /instructions/{id} { allow read: if isAdmin() || isWorker() || isAssistant(); allow write: if isAdmin(); }
    match /telegram_messages/{id} { allow read, write: if isAdmin(); }
    match /telegram_events/{id} { allow read, write: if isAdmin(); }
    match /telegramAttendanceLogs/{id} { allow read, write: if isAdmin(); }
    match /dailyAttendanceReports/{id} { allow read, write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
