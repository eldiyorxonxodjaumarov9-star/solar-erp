rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerOrAdmin(uid) {
      return isSignedIn() && (request.auth.uid == uid || request.auth.token.admin == true);
    }

    match /workers/{docId} {
      // Oylik (salary / dailySalary) — UI da faqat admin (Masterlar, Xarajatlar).
      // Usta paneli bu kolleksiyani to‘liq o‘qimaydi; app-layer role guard asosiy himoya.
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /users/{docId} {
      // workers alias (legacy). salary maydonlari shu yerda ham bo‘lishi mumkin.
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /brigades/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /projects/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /expenses/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /work_logs/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwnerOrAdmin(resource.data.workerAuthUid);
    }

    match /stage_photos/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /project_stage_locks/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /project_worker_days/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /user_activity_logs/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /usta_yorijnoma/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /jalbalar/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /telegram_events/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /telegramAttendanceLogs/{docId} {
      // Server attendance Telegram log — APK o‘qimaydi
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /dailyAttendanceReports/{docId} {
      // Kunlik 20:00 hisobot (idempotent, date = docId)
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /telegram_messages/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /projectSteps/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /attendance/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /points/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /complaints/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /assistants/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /heatPumpForms/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /commercialOffers/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Yangi kolleksiyalar (qoida qo‘shilmasa ham anonim auth bilan ishlashi uchun)
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
